# D6 contingency — only if Cool Mic can't source MP3 directly.
# Phone streams Ogg/Opus to this harbor; Icecast /live receives MP3.
# Replace CHANGE_ME_SOURCE (same password the phone and Icecast use).

settings.log.stdout.set(true)

phone = input.harbor("live", port = 8005, password = "CHANGE_ME_SOURCE")

# fallible=true: when the phone drops, the Icecast source drops too —
# the eye must drowse honestly, not play dead air (§2.3).
output.icecast(
  %mp3(bitrate = 192),
  host = "127.0.0.1",
  port = 8000,
  password = "CHANGE_ME_SOURCE",
  mount = "/live",
  name = "music is magic",
  fallible = true,
  phone
)
